{
  "info": {
    "name": "ecommerce-platform local",
    "_postman_id": "ecommerce-platform-local-collection",
    "description": "Starter collection bám route thật của api-gateway cho local verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.token) { pm.environment.set('access_token', json.data.token); pm.environment.set('admin_access_token', json.data.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users/profile"
          }
        }
      ]
    },
    {
      "name": "Checkout",
      "item": [
        {
          "name": "Preview Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{ \"product_id\": \"{{product_id}}\", \"quantity\": 1 }],\n  \"shipping_method\": \"pickup\"\n}"
            },
            "url": "{{base_url}}/api/v1/orders/preview"
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Idempotency-Key", "value": "{{order_idempotency_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{ \"product_id\": \"{{product_id}}\", \"quantity\": 1 }],\n  \"shipping_method\": \"pickup\"\n}"
            },
            "url": "{{base_url}}/api/v1/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.id) { pm.environment.set('order_id', json.data.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Replay Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Idempotency-Key", "value": "{{order_idempotency_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{ \"product_id\": \"{{product_id}}\", \"quantity\": 1 }],\n  \"shipping_method\": \"pickup\"\n}"
            },
            "url": "{{base_url}}/api/v1/orders"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Idempotency-Key", "value": "{{payment_idempotency_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": \"{{order_id}}\",\n  \"payment_method\": \"manual\"\n}"
            },
            "url": "{{base_url}}/api/v1/payments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.id) { pm.environment.set('payment_id', json.data.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Replay Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Idempotency-Key", "value": "{{payment_idempotency_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": \"{{order_id}}\",\n  \"payment_method\": \"manual\"\n}"
            },
            "url": "{{base_url}}/api/v1/payments"
          }
        },
        {
          "name": "List Payment History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/payments/history"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin Orders First Page",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/admin/orders?limit=8&cursor="
          }
        },
        {
          "name": "Admin Returns",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/admin/returns?page=1&limit=6"
          }
        },
        {
          "name": "Admin Return Queue Health",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/admin/returns/health"
          }
        }
      ]
    }
  ]
}
