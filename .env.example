# Safe template only.
# For local development, copy this file to `.env.local` and fill in real values there.
# `.env.local` is intentionally gitignored and preferred by the Makefile/Compose workflow.
# For production, copy `.env.production.example` to `.env.production` instead.

# development | staging | production — production bắt buộc secret mạnh (service fail fast nếu thiếu)
APP_ENV=development

POSTGRES_DB=ecommerce
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-db-password

JWT_SECRET=change-me-jwt-secret-at-least-32-chars
REDIS_PASSWORD=
REVIEWS_CACHE_ENABLED=false
REVIEWS_CACHE_TTL_SECONDS=60
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change-me-rabbitmq-password
FRONTEND_BASE_URL=http://localhost:3000
NOTIFICATION_WORKER_COUNT=4
NOTIFICATION_PREFETCH_COUNT=8
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_DELAY_SECONDS=30
NOTIFICATION_INBOX_TTL_HOURS=168
NOTIFICATION_PROCESSING_TTL_SECONDS=300
NOTIFICATION_QUEUE_METRICS_INTERVAL_SECONDS=15
# Cảnh báo tồn kho thấp: để trống danh sách người nhận thì worker không chạy.
# Nhiều địa chỉ phân tách bằng dấu phẩy.
NOTIFICATION_LOW_STOCK_RECIPIENTS=
NOTIFICATION_LOW_STOCK_THRESHOLD=5
NOTIFICATION_LOW_STOCK_POLL_INTERVAL_SECONDS=900
PAYMENT_GATEWAY_MOMO_RETURN_URL=http://localhost:3000/payments
# VNPay là provider tùy chọn: để trống thì cổng không được đăng ký và phương thức
# thanh toán "vnpay" bị từ chối ngay ở biên.
PAYMENT_GATEWAY_VNPAY_WEBHOOK_SECRET=
PAYMENT_GATEWAY_VNPAY_RETURN_URL=http://localhost:3000/payments

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=ND Shop
SMTP_FROM_ADDRESS=

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_OTP_MESSAGE_TTL_SECONDS=300
TELEGRAM_OTP_RESEND_COOLDOWN_SECONDS=60
TELEGRAM_OTP_MAX_ATTEMPTS=5
TELEGRAM_OTP_DAILY_LIMIT_PER_USER=5
TELEGRAM_OTP_HOURLY_LIMIT_PER_IP=10
TELEGRAM_SECRET_PEPPER=change-me

EMAIL_VERIFICATION_OTP_MESSAGE_TTL_SECONDS=600
EMAIL_VERIFICATION_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_OTP_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_OTP_DAILY_LIMIT_PER_USER=5
EMAIL_VERIFICATION_OTP_HOURLY_LIMIT_PER_IP=10
EMAIL_VERIFICATION_SECRET_PEPPER=change-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
