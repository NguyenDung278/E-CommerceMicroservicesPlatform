# Production environment template.
# Copy to `.env.production`, điền TOÀN BỘ secret, và không bao giờ commit `.env.production`.
#
# Với APP_ENV=production, mỗi service kiểm tra secret khi startup và FAIL FAST
# nếu còn giá trị mặc định/yếu (xem pkg/config/config.go — validateProductionSecrets):
#   - JWT_SECRET: chuỗi ngẫu nhiên >= 32 ký tự
#   - POSTGRES_PASSWORD / DATABASE_PASSWORD: không được là default
#   - RABBITMQ_PASSWORD: không được là "guest"
#   - PAYMENT_GATEWAY_WEBHOOK_SECRET: không được là "dev-momo-secret"
#   - TELEGRAM_SECRET_PEPPER / EMAIL_VERIFICATION_SECRET_PEPPER: không được là "change-me"
#   - OBJECT_STORAGE_ACCESS_KEY / SECRET_KEY: không được là "minioadmin"
#   - BOOTSTRAP_DEV_ACCOUNTS_ENABLED: phải là false
#
# Sinh secret ngẫu nhiên: openssl rand -base64 48

APP_ENV=production

POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_prod
POSTGRES_PASSWORD=

JWT_SECRET=
REDIS_PASSWORD=
RABBITMQ_USER=ecommerce_prod
RABBITMQ_PASSWORD=

# Origin thật của frontend (CORS + link trong email đều dùng giá trị này)
FRONTEND_BASE_URL=https://shop.example.com
PAYMENT_GATEWAY_MOMO_RETURN_URL=https://shop.example.com/payments
PAYMENT_GATEWAY_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=ND Shop
SMTP_FROM_ADDRESS=

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=https://api.shop.example.com/api/v1/auth/oauth/google/callback

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_PEPPER=

EMAIL_VERIFICATION_SECRET_PEPPER=

OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Tài khoản dev KHÔNG được bật ở production — user-service sẽ từ chối khởi động.
BOOTSTRAP_DEV_ACCOUNTS_ENABLED=false

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
